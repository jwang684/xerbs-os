# ─────────────────────────────────────────────────────────────
# Xerbs OS — environment template
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must NEVER be committed.
# Do not put real secrets in this file.
# ─────────────────────────────────────────────────────────────

# ─── PostgreSQL (started via docker-compose) ───────────────────
POSTGRES_USER=xerbs
POSTGRES_PASSWORD=change_me_in_env_local
POSTGRES_DB=xerbs

# Connection string used by the app (Drizzle). Must match the three values above.
DATABASE_URL=postgresql://xerbs:change_me_in_env_local@localhost:5432/xerbs

# ─── Redis (provisioned for later sprints; unused in Sprint 1) ─
REDIS_URL=redis://localhost:6379

# ─── Better Auth ───────────────────────────────────────────────
# Generate a strong secret, e.g.  openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_random_secret
BETTER_AUTH_URL=http://localhost:3000

# ─── AI provider ───────────────────────────────────────────────
# Which diagnosis AI provider to use: "openai" or "fake".
# "fake" is deterministic and makes no network calls (useful without a key).
AI_PROVIDER=openai

# ─── OpenAI (Responses API) ────────────────────────────────────
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-4o-mini
